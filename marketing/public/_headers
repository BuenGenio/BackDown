/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https://matomo.matumi.anthill.hk; style-src 'self' 'unsafe-inline'; script-src 'self' 'inline-speculation-rules' https://matomo.matumi.anthill.hk; font-src 'self'; connect-src 'self' https://matomo.matumi.anthill.hk; form-action 'self' https://checkout.stripe.com; frame-ancestors 'none'; base-uri 'self'

# The docs' live demo (public/demo/, see tools/demo/README.md) is the app's own UI, shown inside the docs pages:
# it may be framed by this site, and it needs the app's own CSP (blob: images and media, workers, wasm for pdf.js).
/demo/*
  ! X-Frame-Options
  ! Content-Security-Policy
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self'; font-src 'self' data:; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'

/demo/d/*
  Cache-Control: public, max-age=86400

/site.css
  Cache-Control: public, max-age=31536000, immutable

/site.js
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/shots/*
  Cache-Control: public, max-age=86400

/og/*
  Cache-Control: public, max-age=86400

/flags/*
  Cache-Control: public, max-age=604800

/thanks/*
  Referrer-Policy: no-referrer

/:lang/thanks/*
  Referrer-Policy: no-referrer

/thanks/
  Referrer-Policy: no-referrer

/:lang/thanks/
  Referrer-Policy: no-referrer
